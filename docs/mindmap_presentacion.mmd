    B5_5_desc --> B5_5_snip["<div style='min-width:480px; white-space:pre-wrap; text-align:left;'><code># catalogo.py:92-95 · Clase Producto (método destacar)<br/># EAFP + Descarte de trampa bool:<br/>if type(orden) is bool or int(orden) != orden or orden &lt; 1:<br/>  raise ValueError(...)<br/>self._orden_vidriera = int(orden)</code></div>"]:::codeBlock